# Copy to .streamlit/secrets.toml locally (gitignored), or paste the same
# keys into Settings -> Secrets on share.streamlit.io.
#
# These two ARE the login. Rotate by editing APP_PASSWORD here; the app
# reboots and the old password stops working.
APP_USERNAME = "change-me"
APP_PASSWORD = "a long random passphrase"

# Local escape hatch only - opens the console with no gate at all.
# APP_AUTH_DISABLED = "1"

# Anything below is bridged into os.environ at startup by ui/auth.py, so the
# existing os.getenv readers need no change. Add ONLY what the deployed
# instance genuinely needs.
#
# Deliberately omit KITE_API_SECRET on a public deployment: without it
# KiteSession cannot authenticate, the chain falls back to synthetic, and no
# order path can reach the account even if the password is defeated.
# KITE_API_KEY = ""
# TELEGRAM_BOT_TOKEN = ""
# TELEGRAM_CHAT_ID = ""
