# --- Secrets and trade records: these must never reach a remote ---
.env
.env.local
.streamlit/secrets.toml
journal/
*.jsonl

# Kite access token - a bearer credential for a live trading account.
.kite_session.json
.kite_instruments.csv

# --- Market data (large, re-downloadable, not source) ---
data/*.csv
data/*.parquet
data/*.feather
# A snapshot of one pytest run has no lasting value. The EXPERIMENT
# reports beside these (f1_verdict_*.txt, s1_swing_null.txt,
# f4_clean.txt) are kept on purpose - they are the human-readable form
# of numbers the ledgers in data/experiments/ hold only as columns.
data/pytest_*.txt
!data/sample_*.csv
# The swing scanner's universes and your halal rulings are SOURCE, not
# downloaded data - the scan cannot run without them. One universe file per
# market, plus the ETF books the overlap check reads: those are committed for
# the same reason the Nifty list is, so that a CDN outage reads as an outage
# rather than as "you own none of this".
!data/nifty100.csv
!data/us_halal.csv
!data/ftse100.csv
!data/etf_holdings.csv
!data/halal_overrides.csv
data/cache/

# Your capital pots and broker flags. Numbers about YOUR account, not about
# the strategy - the strategy's tunables all live in config.py, in version
# control, where changing one is a diff somebody can read.
data/settings.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Testing / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Logs ---
*.log
logs/

# --- Editors / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

!data/nifty50.csv
!data/nifty500.csv
